<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>OptionsAsTypes</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      CS8981: "the type name only contains lower-cased ascii characters."
      C# reserves all-lowercase type names for future language keywords, so r, q, u, d
      and dt all trip it. Keeping the notation from the papers is the entire point of
      this project, so we opt in deliberately rather than renaming to RiskFreeRate.
    -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

</Project>
